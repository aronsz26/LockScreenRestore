<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>LockScreenRestore</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Padlock, time and date with iOS 15 sizes and positions, plain white instead of tinted, no depth effect.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>iOS 15 Clock</string>
			<key>key</key>
			<string>clockEnabled</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.aronsz26.lockscreenrestore</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Clock Size</string>
			<key>footerText</key>
			<string>Clock size relative to the calculated iOS 15 size (1.0). Adjust it if the clock looks too small or too big on your iPhone, then respring.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>key</key>
			<string>clockSize</string>
			<key>default</key>
			<real>1</real>
			<key>min</key>
			<real>0.7</real>
			<key>max</key>
			<real>1.5</real>
			<key>showValue</key>
			<true/>
			<key>defaults</key>
			<string>com.aronsz26.lockscreenrestore</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Focus shown as a pill under the date instead of at the bottom of the screen.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>iOS 15 Focus</string>
			<key>key</key>
			<string>focusEnabled</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.aronsz26.lockscreenrestore</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Notifications listed right under the clock instead of anchored at the bottom, with iOS 15 card shape and spacing.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>iOS 15 Notifications</string>
			<key>key</key>
			<string>notificationsEnabled</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.aronsz26.lockscreenrestore</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Music player with the iOS 15 layout: large artwork, AirPlay next to the title, time under the progress bar and a volume slider.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>iOS 15 Music Player</string>
			<key>key</key>
			<string>mediaPlayerEnabled</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.aronsz26.lockscreenrestore</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>iOS 15 live wallpapers with automatic Light/Dark switching, and the iOS 15 page in Settings &gt; Wallpaper to pick them (or a photo) for the lock and home screen. Apple's iOS 14 and 15 wallpapers can be downloaded right there. Press and hold the lock screen to play. Turn this off to get iOS 16's wallpapers and lock screen editor back.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>iOS 15 Live Wallpaper</string>
			<key>key</key>
			<string>liveWallpaperEnabled</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.aronsz26.lockscreenrestore</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Sizes and positions are calculated for your screen every time SpringBoard starts. Fix Positions shows what was detected and recalculates.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>Fix Positions</string>
			<key>action</key>
			<string>fixPositions</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Changes take effect after a respring.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>Apply (Respring)</string>
			<key>action</key>
			<string>respring</string>
		</dict>
	</array>
</dict>
</plist>
